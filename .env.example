# InnerOS Personal Brain runtime configuration.
# Copy values into your protected service manager or local untracked .env file.
# Never commit real secrets.

COGNEE_SERVICE_URL=https://api.cognee.ai
COGNEE_API_KEY=
COGNEE_DATASET=inneros-personal-brain
COGNEE_LIVE_VERIFIED=0

# Bright Data SERP API is the primary hackathon path.
BRIGHTDATA_API_KEY=
BRIGHTDATA_SERP_ZONE=inneros
BRIGHTDATA_REST_URL=https://api.brightdata.com/request

# Optional Bright Data MCP fallback.
BRIGHTDATA_API_TOKEN=
BRIGHTDATA_MCP_URL=https://mcp.brightdata.com/mcp

# Local or distributed OpenAI-compatible inference route.
LOCAL_LLM_BASE_URL=http://127.0.0.1:8000/v1
LOCAL_LLM_MODEL=QuantTrio/Qwen3-Coder-30B-A3B-Instruct-AWQ
LOCAL_LLM_API_KEY=local
INNEROS_QWEN_ROUTE_STATE=on_demand

# Coordination and route-status truth. Leave distributed verification to Ralphi coordination.
INNEROS_DISTRIBUTED_RALPHI_VERIFIED=1
INNEROS_MCP_PORT=8102
COGNEE_MCP_PORT=8241

# Optional OAuth-gated connectors.
GOOGLE_APPLICATION_CREDENTIALS=
GMAIL_OAUTH_CLIENT_FILE=
